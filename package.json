{
  "name": "multica",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:desktop": "turbo dev --filter=@multica/desktop",
    "dev:desktop:staging": "turbo dev:staging --filter=@multica/desktop",
    "build": "turbo build --filter=@multica/desktop...",
    "typecheck": "turbo typecheck --filter=@multica/desktop...",
    "test": "turbo test --filter=@multica/desktop...",
    "lint": "turbo lint --filter=@multica/desktop...",
    "knip": "knip",
    "check:ui-exports": "node scripts/check-ui-wildcard-exports.mjs",
    "clean": "turbo clean && rm -rf node_modules",
    "ui:add": "cd packages/ui && npx shadcn@latest add",
    "generate:reserved-slugs": "node scripts/generate-reserved-slugs.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ],
    "overrides": {
      "@types/react": "catalog:",
      "@types/react-dom": "catalog:",
      "@xmldom/xmldom": "^0.8.13",
      "postcss": "8.5.26",
      "uuid": "11.1.1",
      "shell-quote": "1.9.0",
      "minimatch@3>brace-expansion": "1.1.18",
      "minimatch@5>brace-expansion": "2.1.4",
      "minimatch@9>brace-expansion": "2.1.4",
      "minimatch@10>brace-expansion": "5.0.9",
      "builder-util-runtime": "9.7.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "catalog:",
    "knip": "^6.32.2",
    "turbo": "^2.5.4",
    "typescript": "catalog:"
  }
}
