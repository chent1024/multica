# Multica local workbench configuration.
# There is no account, authentication, cloud workspace, PostgreSQL, or Redis.

# Desktop overrides this with <Electron userData>/data/multica.db. Bare local
# development can set an absolute path; otherwise the server uses the OS user
# config directory.
# MULTICA_SQLITE_PATH=/absolute/path/to/multica.db

# Local loopback API and Desktop renderer configuration.
PORT=17824
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:${FRONTEND_PORT}
MULTICA_SERVER_URL=ws://localhost:${PORT}/ws
MULTICA_PUBLIC_URL=http://localhost:${PORT}
MULTICA_APP_URL=${FRONTEND_ORIGIN}
NEXT_PUBLIC_API_URL=http://localhost:${PORT}
NEXT_PUBLIC_WS_URL=ws://localhost:${PORT}/ws

# Local Codex execution. The adapter itself is unchanged in this phase.
MULTICA_DAEMON_CONFIG=
MULTICA_DAEMON_ID=
MULTICA_DAEMON_DEVICE_NAME=
MULTICA_DAEMON_POLL_INTERVAL=3s
MULTICA_DAEMON_HEARTBEAT_INTERVAL=15s
MULTICA_CODEX_PATH=codex
MULTICA_CODEX_MODEL=
MULTICA_CODEX_WORKDIR=
MULTICA_CODEX_TIMEOUT=20m

# Optional local attachment storage.
LOCAL_UPLOAD_DIR=./data/uploads
LOCAL_UPLOAD_BASE_URL=http://localhost:${PORT}
